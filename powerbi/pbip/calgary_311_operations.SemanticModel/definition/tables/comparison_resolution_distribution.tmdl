	partition comparison_resolution_distribution = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(ProjectFolder & "\data\comparison\comparison_resolution_distribution.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"Edition", type text},
				        {"Bucket", type text},
				        {"BucketOrder", Int64.Type},
				        {"ShareOfClosed", type number}
				        },
				        "en-CA")
				in
				    Typed

	annotation PBI_ResultType = Table

