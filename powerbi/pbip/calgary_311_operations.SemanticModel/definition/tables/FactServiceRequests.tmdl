				        {"ResolutionDays", Int64.Type},
				        {"SameDayClosure", Int64.Type},
				        {"BenchmarkDays", Int64.Type},
				        {"WithinBenchmark", Int64.Type},
				        {"OpenAgeDays", type number},
				        {"IsStaleOpen", Int64.Type},
				        {"ClosedDateImputed", Int64.Type},
				        {"ReopenedFlag", Int64.Type}
				        },
				        "en-CA")
				in
				    Typed

