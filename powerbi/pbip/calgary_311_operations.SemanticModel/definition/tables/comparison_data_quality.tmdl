	partition comparison_data_quality = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(ProjectFolder & "\data\comparison\comparison_data_quality.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				        {"Edition", type text},
				        {"Check", type text},
				        {"RowsAffected", Int64.Type},
				        {"PctOfRaw", type number},
				        {"Origin", type text}
				        },
				        "en-CA")
				in
				    Typed

	annotation PBI_ResultType = Table

